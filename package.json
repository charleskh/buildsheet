{
  "name": "buildsheet",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:viewer && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build:viewer": "vite build --config vite.viewer.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5",
    "@types/node": "^26.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "autoprefixer": "^10.6.1",
    "daisyui": "^4.12",
    "postcss": "^8.5.28",
    "svelte": "^5",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4",
    "typescript": "^5.9.3",
    "vite": "^6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/saira-semi-condensed": "^5.3.0"
  }
}
